# Orbit's own server (backend/). When set, the app signs in and loads Today, Plan and Tasks from it.
# Screens that haven't moved over yet say so. Example: https://api.example.com
EXPO_PUBLIC_API_URL=

# Supabase, used only while EXPO_PUBLIC_API_URL is empty (bundled into the app).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
