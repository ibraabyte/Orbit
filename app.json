{
  "expo": {
    "name": "Orbit",
    "slug": "orbit",
    "scheme": "orbit",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ibraabyte.orbit",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ibraabyte.orbit",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icons/expo-adaptive-foreground-1024.png",
        "backgroundColor": "#101511"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Orbit uses Face ID to keep your data private."
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Orbit uses your location to calculate prayer times."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Orbit uses the camera to scan food barcodes and to photograph your meals for calorie estimates.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Orbit lets you pick a photo of your meal to estimate its calories.",
          "cameraPermission": "Orbit uses the camera to scan food barcodes and to photograph your meals for calorie estimates.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "ae8c8b90-e409-486e-af3c-f605d05f3622"
      }
    },
    "owner": "ibraabyte",
    "updates": {
      "url": "https://u.expo.dev/ae8c8b90-e409-486e-af3c-f605d05f3622"
    }
  }
}
