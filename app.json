{
  "expo": {
    "name": "Orbit",
    "slug": "orbit",
    "scheme": "orbit",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ibraabyte.orbit"
    },
    "android": {
      "package": "com.ibraabyte.orbit"
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
