# Local development. On Coolify these come from the compose file and the Environment Variables tab instead.
ORBIT_DATABASE_URL=postgresql+psycopg://orbit:orbit@localhost:5432/orbit
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ORBIT_JWT_SECRET=
ORBIT_ALLOW_SIGNUPS=false

# WHOOP (optional). From your app at developer.whoop.com. The redirect URL must match the one registered there.
ORBIT_WHOOP_CLIENT_ID=
ORBIT_WHOOP_CLIENT_SECRET=
ORBIT_WHOOP_REDIRECT_URI=http://localhost:8000/whoop/callback
# Claude writes the Arabic WHOOP summary (optional). From console.anthropic.com.
ORBIT_ANTHROPIC_API_KEY=
