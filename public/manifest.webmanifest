{
  "name": "Orbit",
  "short_name": "Orbit",
  "description": "Personal command center for tasks, focus, reviews, people, food planning, reminders, health and sleep logs, finance, and saved links.",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f1a14",
  "theme_color": "#0f1a14",
  "orientation": "portrait-primary",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", ".png", ".jpg", ".jpeg", ".webp", ".gif"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "short_name": "Today",
      "url": "/dashboard"
    },
    {
      "name": "Quick Capture",
      "short_name": "Capture",
      "url": "/dashboard#quick-capture"
    },
    {
      "name": "Plan Week",
      "short_name": "Plan",
      "url": "/plan"
    },
    {
      "name": "Review",
      "short_name": "Review",
      "url": "/review"
    },
    {
      "name": "Inbox",
      "short_name": "Inbox",
      "url": "/inbox"
    },
    {
      "name": "Focus",
      "short_name": "Focus",
      "url": "/focus"
    },
    {
      "name": "Food",
      "short_name": "Food",
      "url": "/food"
    },
    {
      "name": "People",
      "short_name": "People",
      "url": "/people"
    },
    {
      "name": "Finance",
      "short_name": "Finance",
      "url": "/finance"
    },
    {
      "name": "Journal",
      "short_name": "Journal",
      "url": "/journal"
    },
    {
      "name": "Goals",
      "short_name": "Goals",
      "url": "/goals"
    },
    {
      "name": "Command",
      "short_name": "Command",
      "url": "/command"
    }
  ]
}
